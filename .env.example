# Deployment configuration for the flyco control plane.
#
# Copy to `.env` (git-ignored) and fill in. `skyzen deploy` expands the
# `${NAME}` placeholders in `crates/api/Skyzen.toml` from the process
# environment first, then from this file; `skyzen dev` and `cargo test`
# read the same names straight out of the environment.
#
# Everything marked SECRET belongs in `skyzen secret set NAME` for a
# deployed Worker, never in `[cloudflare.vars]`.

# --- Cloudflare resources (created by hand; see crates/api/Skyzen.toml) ---
CLOUDFLARE_ACCOUNT_ID=
FLYCO_AUTH_KV_ID=
FLYCO_D1_DATABASE_ID=
FLYCO_CUSTOM_DOMAIN=dev.flyco.dev

# --- GitHub sign-in ---
FLYCO_GITHUB_CLIENT_ID=
# SECRET
FLYCO_GITHUB_CLIENT_SECRET=
FLYCO_REDIRECT_URI=https://dev.flyco.dev/v1/auth/github/callback
# SECRET: the shared secret GitHub signs webhook deliveries with.
FLYCO_GITHUB_WEBHOOK_SECRET=

# --- Claude Code sign-in (docs/ux.md §8) ---
# The OAuth client the browser flow presents to Anthropic. Public by
# design: the flow is a public client with PKCE and Anthropic issues no
# client secret for it. The default is the Claude Code CLI's own client
# id, which is what makes the flow flyco runs the flow Anthropic already
# supports; a deployment that registers its own client sets this instead.
FLYCO_CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# --- Secrets at rest and Web Push ---
# SECRET: 32 bytes of lowercase hex, sealing every third-party token.
FLYCO_ENCRYPTION_KEY=
# SECRET: raw P-256 private key, base64url, unpadded.
FLYCO_VAPID_PRIVATE_KEY=
FLYCO_VAPID_SUBJECT=mailto:me@lexo.cool

# --- Native runs only (`skyzen dev`, the openapi export) ---
FLYCO_DATABASE_URL=sqlite://flyco.db
