# Deployment configuration for the flyco control plane.
#
# Copy to `crates/api/.env` (git-ignored) and fill in. `skyzen deploy` expands
# the `${NAME}` placeholders in `crates/api/Skyzen.toml` from the process
# environment first, then from this file next to the manifest; `skyzen dev` and `cargo test`
# read the same names straight out of the environment.
#
# Everything marked SECRET belongs in `skyzen secret set NAME` for a
# deployed Worker, never in `[cloudflare.vars]`.

# --- Cloudflare resources (created by hand; see crates/api/Skyzen.toml) ---
CLOUDFLARE_ACCOUNT_ID=
FLYCO_AUTH_KV_ID=
FLYCO_D1_DATABASE_ID=
FLYCO_CUSTOM_DOMAIN=dev.flyco.dev

# --- GitHub sign-in ---
FLYCO_GITHUB_CLIENT_ID=
# SECRET
FLYCO_GITHUB_CLIENT_SECRET=
# The one callback the OAuth app registers per hostname: it serves the
# sign-in and the Codespaces link alike — which flow a return belongs to is
# decided by the `state`, not the path.
FLYCO_REDIRECT_URI=https://dev.flyco.dev/v1/auth/github/callback
# SECRET: the shared secret GitHub signs webhook deliveries with.
FLYCO_GITHUB_WEBHOOK_SECRET=

# --- Claude Code sign-in (docs/ux.md §8) ---
# The OAuth client the browser flow presents to Anthropic. Public by
# design: the flow is a public client with PKCE and Anthropic issues no
# client secret for it. The default is the Claude Code CLI's own client
# id, so flyco runs the flow Anthropic already supports; a deployment that registers its own client sets this instead.
FLYCO_CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# --- Codex sign-in (docs/ux.md §8) ---
# The OAuth client the ChatGPT device-code flow presents to OpenAI. Public
# for the same reason: OpenAI issues no client secret for it. The default is
# the Codex CLI's own client id, so flyco runs the flow OpenAI already
# supports; a deployment that registers its own client sets this instead.
FLYCO_CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# --- Linking a cloud account by signing in with it ---
# The OAuth application "Sign in with Microsoft" presents. A confidential
# client, unlike the harness ones: the flow redirects back to flyco, so
# Microsoft issues a client secret. Register the callback URI as
# https://dev.flyco.dev/v1/providers/azure/oauth/callback and grant the
# delegated permissions the flow asks consent for
# (https://management.azure.com/user_impersonation and
# Microsoft Graph Application.ReadWrite.All).
FLYCO_AZURE_OAUTH_CLIENT_ID=
# SECRET
FLYCO_AZURE_OAUTH_CLIENT_SECRET=

# The OAuth client "Sign in with Google" presents, a Web application in the
# Google Cloud console with the callback URI
# https://dev.flyco.dev/v1/providers/gcp/oauth/callback and the
# cloud-platform and userinfo.email scopes on its consent screen.
FLYCO_GOOGLE_OAUTH_CLIENT_ID=
# SECRET
FLYCO_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Turnstile (the human check guarding sign-in) ---
# The sitekey is public by design — it is embedded in the page — so it is a
# var; `GET /v1/config` serves it back to the SPA. Cloudflare's testing
# pair below always passes, which is what a local `skyzen dev` wants; a
# production deploy uses the widget's own sitekey. Register the widget with
# `wrangler turnstile widget create <name> --domain <host> --mode non-interactive`.
FLYCO_TURNSTILE_SITEKEY=1x00000000000000000000AA
# SECRET: Cloudflare's testing secret below always passes for the testing
# sitekey; production sets the widget's own via `skyzen secret set`.
FLYCO_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Comma-separated hostnames a verified token may have been minted on. The
# testing pair ignores this, but a real deployment must list exactly the
# hosts that serve the login page.
FLYCO_TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# --- Secrets at rest and Web Push ---
# SECRET: 32 bytes of lowercase hex, sealing every third-party token.
FLYCO_ENCRYPTION_KEY=
# SECRET: raw P-256 private key, base64url, unpadded.
FLYCO_VAPID_PRIVATE_KEY=
FLYCO_VAPID_SUBJECT=mailto:me@lexo.cool

# --- Native runs only (`skyzen dev`, the openapi export) ---
FLYCO_DATABASE_URL=sqlite://flyco.db
