# Deploy-time interpolation for crates/api/Skyzen.toml.
# Copy to `.env` (gitignored) and fill in. Process environment wins over this file.
#
# Worker secrets — FLYCO_GITHUB_CLIENT_SECRET, FLYCO_ENCRYPTION_KEY — are not
# listed here. Put those with `skyzen secret set` / `wrangler secret put`.

CLOUDFLARE_ACCOUNT_ID=
FLYCO_CUSTOM_DOMAIN=
FLYCO_AUTH_KV_ID=
FLYCO_D1_DATABASE_ID=
FLYCO_GITHUB_CLIENT_ID=
FLYCO_REDIRECT_URI=
