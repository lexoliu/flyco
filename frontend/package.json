{
  "name": "flyco-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "api:check": "bun run scripts/check-api-schema.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "eventsource-parser": "^4.1.0",
    "highlight.js": "^11.12.0",
    "lucide-solid": "^1.39.0",
    "marked": "^18.0.11",
    "simple-icons": "^16.29.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bun": "^1.2.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-solid": "^2.11.2",
    "vitest": "^3.0.5"
  }
}
